{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/dev-flow/hooks/session-start.sh",
            "timeout": 30,
            "statusMessage": "dev-flow 状態確認"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/dev-flow/hooks/pre-agent-check.sh",
            "timeout": 10,
            "statusMessage": "dev-flow 起動前検証"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/dev-flow/hooks/pr-merge-guard.sh",
            "timeout": 60,
            "statusMessage": "dev-flow 自動マージ条件検証"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/dev-flow/hooks/state-sync.sh",
            "timeout": 20,
            "statusMessage": "dev-flow 状態同期"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/skills/dev-flow/hooks/doc-validate.sh",
            "timeout": 30,
            "statusMessage": "dev-flow 成果物検証"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/dev-flow/hooks/agent-complete.sh",
            "timeout": 10,
            "statusMessage": "dev-flow 完了記録"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/dev-flow/hooks/stop-summary.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
